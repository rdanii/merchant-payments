# Local development values only. Copy to .env (git-ignored) and adjust.
# Never put production credentials in this file.
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=payments

# Development-only provider simulator (refused when APP_ENV=production).
DEVSIM_ENABLED=true
DEVSIM_WEBHOOK_SECRET=change-me-local-dev-secret

# OVO SNAP Dynamic QRIS (disabled by default). Values come from OVO merchant
# onboarding; never commit real ones. See docs/providers.md before enabling.
OVO_ENABLED=false
# OVO_BASE_URL=
# OVO_CLIENT_ID=
# OVO_CLIENT_SECRET=
# OVO_PRIVATE_KEY_FILE=
# OVO_PARTNER_ID=
# OVO_CHANNEL_ID=
# OVO_MERCHANT_ID=
# OVO_TERMINAL_ID=
# OVO_DEVICE_ID=
# OVO_ALLOWED_SOURCES=100
# OVO_QR_EXPIRY_SECONDS=
